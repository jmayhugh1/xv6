{
  "version": 4,
  "configurations": [
    {
      "name": "riscv64-unknown-elf",
      "compilerPath": "/opt/homebrew/bin/riscv64-unknown-elf-gcc",
      "intelliSenseMode": "gcc-arm64",
      "cStandard": "c11",
      "cppStandard": "${default}",
      "includePath": [
        "${workspaceFolder}"
      ],
      "compilerArgs": [
        "-I${workspaceFolder}",
        "-ffreestanding"
      ]
    }
  ]
}