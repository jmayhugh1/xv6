{
  "version": 4,
  "configurations": [
    {
      "name": "macos-gcc-x64",
      "compilerPath": "/opt/homebrew/bin/riscv64-unknown-elf-gcc",
      "intelliSenseMode": "macos-gcc-x64",
      "cStandard": "${default}",
      "cppStandard": "${default}",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "compilerArgs": [
        "-I${workspaceFolder}",
        "-ffreestanding"
      ]
    }
  ]
}